# Copy to .env.local and fill in. Without these, runs fall back to local simulation.

# Azure DevOps target (defaults shown)
ADO_ORG=vfuk-digital
ADO_PROJECT=Digital

# ADO auth resolves per request, in this order:
#   1. The caller's own Personal Access Token — pasted in the hub's Settings page,
#      stored in their browser, sent per request. This is the multi-user path
#      (shared / Docker deploy): every user reads/queues as their own identity.
#      Nothing to set here — it never touches the server env.
#   2. The host's Azure CLI session (`az login`) — local single-user dev. The hub
#      mints a token via `az account get-access-token`; Azure CLI's first-party
#      client is pre-consented for ADO, so no app registration is needed.
#   3. The service PAT below — shared fallback for CI / simulation gating.
#
# Optional service token (basic auth). Needs Build (Read & Execute) on the pipelines.
AZDO_PAT=

# Pipeline definition id per capability. Map capabilityId (uppercased, - -> _).
# Find the id in the pipeline URL: .../_build?definitionId=<ID>
# Only Wiki Weaver still runs via an ADO Pipeline — every other capability runs
# in-process against the direct-REST Copilot API (see COPILOT_GITHUB_TOKEN below).
PIPELINE_WORKITEM_WIKI_DOC=

# GitHub token used to call the Copilot chat-completions API directly (lib/copilot.ts)
# for every "local"/"hub-inline" capability. Normally pasted by each user in the
# hub's Settings page and sent per request — nothing to set here for that path.
# Only needed here if you want a server-side fallback for local/CI runs.
COPILOT_GITHUB_TOKEN=

# Bug Triage's optional DataDog Logs Search correlation. Skipped gracefully when
# DD_APP_KEY is unset.
DD_APP_KEY=
DD_API_KEY=
DD_SITE=datadoghq.com

# Ideas board (Nun) — Postgres connection. Local Docker or Neon pooled URL.
DATABASE_URL=
# Comma-separated UPNs allowed to curate ideas (status/impact/pin). Empty → open (prototype).
IDEAS_ADMINS=
